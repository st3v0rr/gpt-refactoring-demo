# Kanboard Configuration
KANBOARD_USERNAME=admin
KANBOARD_PASSWORD=admin

LIBRECHAT_USERNAME=admin@localhost.com
LIBRECHAT_PASSWORD=admin

# JWT Secrets (generiere sichere zufällige Strings)
JWT_SECRET=your-secure-jwt-secret-here
JWT_REFRESH_SECRET=your-secure-refresh-secret-here

# MongoDB Credentials
MONGODB_USERNAME=admin
MONGODB_PASSWORD=admin

# Wiki.js Konfiguration
WIKIJS_DB_USERNAME=admin
WIKIJS_DB_PASSWORD=admin
WIKIJS_ADMIN_EMAIL=admin@localhost.com

# Wiki.js API Key - Muss nach Setup in Wiki.js erstellt werden
# 1. In Wiki.js einloggen
# 2. Admin Area > API Access
# 3. Neuen API Key erstellen
WIKIJS_API_KEY=

# Anthropic API Key
ANTHROPIC_API_KEY=

# Neo4j (optional, defaults in docker-compose)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j
